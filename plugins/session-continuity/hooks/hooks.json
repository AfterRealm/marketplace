{
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "command -v python3 >/dev/null 2>&1 && python3 \"${CLAUDE_PLUGIN_ROOT}/scripts/session_start.py\" || python \"${CLAUDE_PLUGIN_ROOT}/scripts/session_start.py\"",
            "shell": "bash",
            "statusMessage": "Checking session history..."
          }
        ]
      }
    ]
  }
}
